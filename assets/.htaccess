Options -Indexes

RewriteEngine On

# Allow requests coming from your own site
RewriteCond %{HTTP_REFERER} !^https?://intranetchd8\.doh\.gov\.ph/ [NC]
RewriteCond %{HTTP_REFERER} !^https?://192\.168\.2\.35/ [NC]
RewriteCond %{HTTP_REFERER} !^https?://127\.0\.0\.1/ [NC]

# Block direct access
RewriteRule \.(js|css|png|jpeg|jpg)$ - [R=404,L]